# Server only; Supabase transaction-pooler URL. Never NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
DB_SCHEMA=bright_path
# Isolated integration schema, never the demo schema.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
TEST_DB_SCHEMA=bright_path_test

# Local schema/seed owner only; NEVER deploy this value.
MIGRATION_DATABASE_URL=postgresql://OWNER:PASSWORD@HOST:6543/postgres
